---
// Дефолтный футер Starlight плюс две ссылки на GitHub.
//
// editUrl считает сам Starlight из editLink.baseUrl — он знает реальный путь файла
// (index.md, .mdx, локаль ru), а собранный из entry.id путь на них промахивается.
import Default from '@astrojs/starlight/components/Footer.astro';
import Sources from './Sources.astro';
import { footerStringsFor } from '../footer-strings';

const { editUrl, locale } = Astro.locals.starlightRoute;
const t = footerStringsFor(locale);

// Заголовок issue называет адрес, который читатель видел. entry.id для этого не
// годится: на непереведённой русской странице он указывает на английский исходник,
// а на английской главной он пустой.
const issueUrl =
  'https://github.com/Smolevich/pet-project-atlas/issues/new' +
  '?template=page-did-not-help.yml' +
  `&title=${encodeURIComponent(t.issueTitle(Astro.url.pathname))}`;
---

<Sources />

<Default><slot /></Default>

<p class="atlas-feedback">
  {editUrl && <a href={editUrl.href}>{t.edit}</a>}
  {editUrl && ' · '}
  <a href={issueUrl}>{t.didNotHelp}</a>
</p>

<style>
  .atlas-feedback {
    margin-top: 1.5rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
  .atlas-feedback a {
    color: var(--sl-color-gray-3);
  }
  .atlas-feedback a:hover {
    color: var(--sl-color-white);
  }
</style>
