---
// Источники страницы, под текстом и до навигации.
//
// Сайт обещает читателю «число с датой и источником, или никакого числа», а
// sources: жил только во frontmatter: цифры приходили голыми. Блок стоит перед
// стандартным футером Starlight, потому что это доказательство к статье, а не
// служебная строка: пагинация уводит со страницы, источники должны попасться
// раньше.
//
// Дата замера здесь же: updated: — это день, когда цифры сняты, а строка
// «Last updated» у Starlight считается по git и отвечает на другой вопрос.
//
// Список плоский. Раньше чужие ссылки сводились по хосту, потому что текстом
// ссылки был путь, и семь путей с одного домена читались как свалка. Теперь
// текст ссылки — заголовок, различают записи заголовки, а имя хоста осталось
// подписью справа. Группировка при этом только уводила заголовок на уровень
// вниз, под ярлык, который сам ничего не сообщает.
import { groupOwnMeasurements, orderSources } from '../../scripts/lib/sources.mjs';
import { footerStringsFor } from '../footer-strings';

const { entry, locale } = Astro.locals.starlightRoute;
const data = entry.data as { sources?: string[]; updated?: Date };

const sources = groupOwnMeasurements(orderSources(data.sources));
const updated = data.updated instanceof Date ? data.updated : undefined;
const t = footerStringsFor(locale);

// ru-RU печатает дату как «12 августа 2026 г.» — точка у неё уже своя, и
// вторая от предложения давала «г..» на каждой русской странице.
const updatedText = updated ? t.formatDate(updated) : '';
const updatedStop = updatedText.endsWith('.') ? '' : '.';

// Дата замера приходит как YYYY-MM-DD. Полдень UTC, чтобы день не уехал ни в
// одну сторону при форматировании.
const measuredText = (measured: string) => t.measuredOn(t.formatDate(new Date(`${measured}T12:00:00Z`)));
---

{
  sources.length > 0 && (
    <aside class="atlas-sources" aria-labelledby="atlas-sources-heading">
      <h2 id="atlas-sources-heading">{t.sources}</h2>

      {updated && (
        <p class="atlas-sources-updated">
          {t.figuresRead}{' '}
          <time datetime={updated.toISOString().slice(0, 10)}>{updatedText}</time>
          {updatedStop}
        </p>
      )}

      <ul>
        {sources.map((source) =>
          source.kind === 'url' ? (
            <li>
              <a href={source.href} rel="noopener">
                {source.title ?? `${source.host}${source.path}`}
              </a>
              {source.title && <span class="atlas-source-host">{source.host}</span>}
            </li>
          ) : (
            <li>
              <span class="atlas-source-kind">{t.ownMeasurement}</span>{' '}
              <span class="atlas-source-text">
                {source.instrument && !source.scope ? (
                  <>
                    {source.instrument}, {measuredText(source.measured)}
                  </>
                ) : source.instrument ? (
                  <>
                    {source.instrument} —{' '}
                    {source.identifiers && source.identifiers.length > 1
                      ? t.scopeWordPlural(source.scope)
                      : t.scopeWord(source.scope)}{' '}
                    {(source.identifiers ?? [source.identifier]).map((id, i) => (
                      <>
                        {i > 0 && ', '}
                        <code>{id}</code>
                      </>
                    ))}
                    , {measuredText(source.measured)}
                  </>
                ) : (
                  source.text
                )}
              </span>
            </li>
          ),
        )}
      </ul>
    </aside>
  )
}

<style>
  .atlas-sources {
    margin-top: 3rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--sl-color-hairline-light);
  }
  .atlas-sources h2 {
    margin: 0;
    font-size: var(--sl-text-h5);
    font-weight: 600;
    line-height: var(--sl-line-height-headings);
    color: var(--sl-color-white);
  }
  .atlas-sources-updated {
    margin: 0.35rem 0 0;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
  .atlas-sources ul {
    margin: 0.85rem 0 0;
    padding: 0;
    list-style: none;
    font-size: var(--sl-text-sm);
  }
  .atlas-sources li {
    /* Длинный путь ссылки не должен растягивать колонку. */
    overflow-wrap: anywhere;
    line-height: 1.5;
  }
  .atlas-sources li + li {
    margin-top: 0.45rem;
  }
  .atlas-sources a {
    color: var(--sl-color-text-accent);
    text-decoration: none;
  }
  .atlas-sources a:hover {
    text-decoration: underline;
  }
  /* Хост — подпись к заголовку, а не вторая ссылка: точка отделяет его, и
     обе части остаются серыми. */
  .atlas-source-host {
    color: var(--sl-color-gray-3);
  }
  .atlas-source-host::before {
    content: '·';
    margin-inline: 0.45em;
  }
  /* Замер отличается от публикации без чтения строки: у него метка и нет
     ссылочного цвета. */
  .atlas-source-kind {
    display: inline-block;
    margin-inline-end: 0.5em;
    padding: 0 0.4em;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.25rem;
    font-size: var(--sl-text-xs);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    white-space: nowrap;
    color: var(--sl-color-gray-2);
  }
  .atlas-source-text {
    color: var(--sl-color-gray-2);
  }
  .atlas-source-text code {
    font-size: 0.95em;
  }
</style>
